# =============================================================================
# GovCheck - Security & Git Ignore Configuration
# =============================================================================

# 1. Environment & Secrets (CRITICAL - NEVER COMMIT REAL SECRETS TO GIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 2. Local Configuration Overrides
config.local.*
*.local.*
*.local

# 3. Dependencies
node_modules/
*/node_modules/
backend/node_modules/
frontend/node_modules/

# 4. Production Builds & Compiled Output
dist/
*/dist/
build/
*/build/
*.tsbuildinfo

# 5. Logs & Temporary Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Operating System & Editor Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?