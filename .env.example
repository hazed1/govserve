# =============================================================================
# GovCheck Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` (e.g., `cp .env.example .env`)
# 2. Fill in your real credentials in the `.env` file.
# 3. DO NOT commit or push your `.env` file to GitHub!
# =============================================================================

# --- 1. Backend Server Configuration ---
PORT=5000

# --- 2. PostgreSQL Database Credentials ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=postgres

# --- 3. Google Gmail SMTP (2-Factor OTP Email Delivery) ---
# NOTE: Use a Google App Password (16 letters), not your personal Gmail login password.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
EMAIL_FROM="GovServe Official Portal" <your-email@gmail.com>
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60


# --- 4. Optional: Brevo REST API (Transactional Email Fallback) ---
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# EMAIL_FROM_ADDRESS=your_verified_sender@domain.com

# --- 5. Frontend Client Configuration (Vite) ---
VITE_API_URL=http://localhost:5000/api

# --- 6. Google Gemini AI Configuration (Chatbot, Document OCR & Permit Intelligence) ---
# Get free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

